CHATWOOT_OPS_PORT=3317
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=replace-with-user-access-token
CHATWOOT_MAX_PAGES=20
OPS_USERNAME=admin
OPS_PASSWORD=replace-with-strong-password
WEBHOOK_SECRET=replace-with-webhook-secret
# WEBHOOK_MAX_AGE_SECONDS=300
DATA_DIR=./data
# Legacy reopen router — RETIRED. No longer wired into the webhook flow (Fahd /
# Botpress owns all routing). These REOPEN_ROUTER_* vars are inert at runtime.
REOPEN_ROUTER_ENABLED=false
REOPEN_ROUTER_STATUSES=offline,busy,away,unavailable,missing
REOPEN_ROUTER_FALLBACK=unassign
REOPEN_ROUTER_ASSIGN_UNASSIGNED=true
REOPEN_ROUTER_COOLDOWN_SECONDS=60
# Limit source inboxes. Example: Operations Inbox only.
# REOPEN_ROUTER_INBOX_IDS=27
# Limit target assignment to one Chatwoot team.
# REOPEN_ROUTER_TEAM_ID=3
# Optional extra whitelist inside that team.
# REOPEN_ROUTER_AGENT_IDS=21,28,71,73,22
# Legacy department (menu "اضغط 1/2/3") router — RETIRED from the live webhook
# flow. DEPARTMENT_ROUTER_ENABLED no longer gates anything at runtime and can be
# removed. IMPORTANT: the Fahd bot still reads the team/agent/business-hours/text
# settings below (DEPARTMENT_ROUTER_SALES_TEAM_ID, _OPERATIONS_TEAM_ID,
# _SALES_AGENT_IDS, _OPERATIONS_AGENT_IDS, _COMPLAINT_AGENT_*, _BUSINESS_*,
# _SALES_ASSIGNMENT_MODE, _ASSIGN_AGENT, and the confirmation texts) for its own
# routing — keep those configured.
DEPARTMENT_ROUTER_ENABLED=false
DEPARTMENT_ROUTER_INBOX_IDS=27
DEPARTMENT_ROUTER_SALES_TEAM_ID=4
DEPARTMENT_ROUTER_OPERATIONS_TEAM_ID=3
# Strict assignment pools. Agents must also belong to the selected team and inbox.
DEPARTMENT_ROUTER_SALES_AGENT_IDS=20,18
DEPARTMENT_ROUTER_OPERATIONS_AGENT_IDS=21,28,71,73,22
DEPARTMENT_ROUTER_PROMPT_ON_NEW=true
DEPARTMENT_ROUTER_PROMPT_ON_RESOLVED=true
DEPARTMENT_ROUTER_NEW_CONTACTS_ONLY=true
DEPARTMENT_ROUTER_CONFIRM_SELECTION=true
DEPARTMENT_ROUTER_SKIP_CAMPAIGNS=true
# Keep leave/offline agents out of new assignments. If both Resale agents are
# unavailable, the conversation stays Unassigned in the Resale team.
DEPARTMENT_ROUTER_SALES_ASSIGNMENT_MODE=online
# Complaint owner. Prefer the exact Chatwoot user id when available.
DEPARTMENT_ROUTER_COMPLAINT_AGENT_NAME=Abdelrahman Tarek
# DEPARTMENT_ROUTER_COMPLAINT_AGENT_ID=
# DEPARTMENT_ROUTER_COMPLAINT_AGENT_EMAIL=
# Set to false to route trainee support to the Operations team only and leave it
# Unassigned (no specific operations agent is auto-assigned).
DEPARTMENT_ROUTER_ASSIGN_AGENT=true
# Business hours: when enabled, assign an online agent INSIDE these hours and
# route to the team unassigned OUTSIDE them. Overrides DEPARTMENT_ROUTER_ASSIGN_AGENT.
DEPARTMENT_ROUTER_BUSINESS_HOURS_ENABLED=false
DEPARTMENT_ROUTER_BUSINESS_TIMEZONE=Africa/Cairo
DEPARTMENT_ROUTER_BUSINESS_START=09:00
DEPARTMENT_ROUTER_BUSINESS_END=22:00
# Working days, 0=Sunday ... 6=Saturday (comma-separated).
DEPARTMENT_ROUTER_BUSINESS_DAYS=0,1,2,3,4,5,6

REOPEN_ROUTER_SKIP_CAMPAIGNS=true
# External campaign replies bypass both routers for this many seconds.
# Use the same value in Chatwoot Actions and the Campaign Uploader.
CAMPAIGN_MARKER_TTL_SECONDS=2592000
BOTPRESS_WEBHOOK_URL=https://webhook.botpress.cloud/your-messaging-api-webhook-id
# Optional Botpress Personal Access Token for Messaging API Bearer auth.
BOTPRESS_PAT=replace-with-botpress-personal-access-token
BRIDGE_REQUIRE_LABEL=needs-bot
# Removed from the conversation after Fahd hands it off, so later customer
# replies do not re-enter the bot.
BOTPRESS_CLOUD_CLEAR_LABEL=needs-bot
BOT_INBOX_IDS=27
# When a human agent takes a bot conversation (assigns it), drop the needs-bot
# label so Fahd stops. On by default; set to false to disable. Assumes the bot
# inbox does NOT use Chatwoot auto-assignment (otherwise the label would be
# stripped from every conversation).
BRIDGE_DROP_LABEL_ON_ASSIGN=true

# --- Customer-silence timeout escalation -------------------------------------
# A background sweep that hands a conversation to a human when the customer goes
# silent mid-chat with Fahd. It scans the bot inbox for open, Unassigned chats
# carrying the needs-bot label whose last public message is an unanswered
# outgoing (bot) message older than CUSTOMER_TIMEOUT_MINUTES, then routes each
# one through the existing /botpress-cloud handoff (an online agent inside
# working hours, otherwise the team Unassigned) and clears needs-bot.
CUSTOMER_TIMEOUT_ENABLED=false
# How long the customer can stay silent before the chat is handed to a human.
CUSTOMER_TIMEOUT_MINUTES=10
# How often the sweep runs (seconds; minimum 15).
CUSTOMER_TIMEOUT_SWEEP_SECONDS=60
# Inboxes to scan. Defaults to BOT_INBOX_IDS when unset.
# CUSTOMER_TIMEOUT_INBOX_IDS=27
# Label that marks a bot-managed conversation. Defaults to BRIDGE_REQUIRE_LABEL.
# CUSTOMER_TIMEOUT_LABEL=needs-bot
# Department used for the handoff when none is saved on the conversation.
CUSTOMER_TIMEOUT_DEPARTMENT=operations
# Per-conversation guard so a lagging label update cannot double-escalate.
CUSTOMER_TIMEOUT_COOLDOWN_SECONDS=600
# Working hours for the assign-vs-queue decision. Defaults to the BOTPRESS_CLOUD_*
# hours so Friday / off-hours route to the team Unassigned by rule (never pinned
# to an offline agent). Set to false to always try assigning an online agent.
# CUSTOMER_TIMEOUT_WORKING_HOURS_ENABLED=true
# Safety caps for each sweep.
CUSTOMER_TIMEOUT_MAX_PAGES=3
CUSTOMER_TIMEOUT_MAX_CONVERSATIONS=50

# --- Voice-note transcription (Deepgram) -------------------------------------
# A customer voice note reaches Chatwoot with empty text + an audio attachment,
# so the bridge would skip it and the chat stalls. When enabled, the bridge
# downloads the audio, transcribes it with Deepgram, and forwards the text to
# Fahd on the SAME conversation (new or existing). If transcription is off or
# fails it forwards VOICE_TRANSCRIBE_FALLBACK_TEXT so the chat still reaches the
# bot instead of stalling. Opt-in: inert unless enabled AND a key is set.
VOICE_TRANSCRIBE_ENABLED=false
DEEPGRAM_API_KEY=replace-with-deepgram-api-key
# nova-3 has the strongest Arabic (incl. Egyptian) accuracy; called as ?model=nova-3&language=ar
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ar
VOICE_TRANSCRIBE_FALLBACK_TEXT=[رسالة صوتية]
# Override only for testing against a mock endpoint.
# DEEPGRAM_URL=https://api.deepgram.com/v1/listen

# --- Lead-source survey ("how did you hear about us?") -----------------------
# Asks the customer where they heard about you and stores it as the `lead_source`
# custom attribute (+ a Chatwoot label). By default it runs at the START of a
# fresh conversation. Choices map an Arabic display to an ASCII value with
# `display=value`; the customer sees the display, the label/attribute use the value.
LEAD_SOURCE_ROUTER_ENABLED=false
LEAD_SOURCE_ROUTER_INBOX_IDS=25
LEAD_SOURCE_OPTIONS=فيسبوك=facebook|إنستجرام=instagram|يوتيوب=youtube|تيك توك=tiktok|جوجل=google|سناب شات=snapchat|ترشيح=referral|أخرى=other
LEAD_SOURCE_ATTRIBUTE_KEY=lead_source
LEAD_SOURCE_LABEL_COLOR=#1f93ff
# \n renders as a real line break; {options} is replaced with the numbered choices.
LEAD_SOURCE_PROMPT_TEXT=ممكن نعرف حضرتك عرفتنا منين؟\n\n{options}\n\nاكتب رقم الاختيار فقط.
# Sent right after a valid choice. Empty string disables it.
LEAD_SOURCE_CONFIRM_TEXT=شكرًا لتواصلك مع إنجوسوفت 🌟\nتم تسجيل بياناتك بنجاح. 🙏
LEAD_SOURCE_ASK_ONCE_PER_CONTACT=true

# --- Post-resolution rating survey (CSAT) ------------------------------------
# Asks for a satisfaction rating AFTER a conversation is resolved, on the given
# inboxes. Use a dedicated inbox (not a Fahd/Botpress bot inbox) so the reply is
# captured by the survey and not forwarded to the bot.
RESOLVE_SURVEY_ENABLED=false
RESOLVE_SURVEY_INBOX_IDS=25
RESOLVE_SURVEY_MIN_RATING=1
RESOLVE_SURVEY_MAX_RATING=5
RESOLVE_SURVEY_ATTRIBUTE_KEY=csat_rating
RESOLVE_SURVEY_ACK_TEXT=تم تسجيل بياناتك بنجاح ✅
RESOLVE_SURVEY_RATING_TEXT=قيّم تجربتك مع خدمتنا{agent} من {min} إلى {max}:\n{max} = ممتاز، {min} = سيئة جدًا\nاكتب رقم من {min} إلى {max} فقط.
RESOLVE_SURVEY_AGENT_TEMPLATE= ومع الموظف المسؤول ({agent})
RESOLVE_SURVEY_THANKS_TEXT=شكرًا لتقييمك! 🌟 استلمنا تقييمك ({rating}/{max}) وهيساعدنا نطوّر خدمتنا.
# When true, the survey asks the lead-source question FIRST (reusing the
# LEAD_SOURCE_* config above), then chains into the rating. Set
# LEAD_SOURCE_ROUTER_ENABLED=false to ask it only after resolve, not at the start.
RESOLVE_SURVEY_ASK_LEAD_SOURCE=false
